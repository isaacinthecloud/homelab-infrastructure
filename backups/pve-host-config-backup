#!/bin/sh
# Weekly archive of Proxmox host config (/etc incl. /etc/pve, network, fstab, storage) to the NAS.
# Keeps the last 8. Fails loudly (non-zero) if the NAS backup storage is not mounted.
set -e
DEST=/mnt/pve/truenas-backups/host
mountpoint -q /mnt/pve/truenas-backups || { echo "truenas-backups not mounted" >&2; exit 1; }
mkdir -p "$DEST"
tar -czf "$DEST/pve-etc-$(date +%Y%m%d-%H%M).tar.gz" -C / etc root/.ssh 2>/dev/null || [ $? -eq 1 ]
ls -1t "$DEST"/pve-etc-*.tar.gz | tail -n +9 | xargs -r rm -f
