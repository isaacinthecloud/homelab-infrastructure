{
 "Version": "2012-10-17",
 "Statement": [
  {
   "Sid": "FindBucket",
   "Effect": "Allow",
   "Action": [
    "s3:ListAllMyBuckets",
    "s3:GetBucketLocation"
   ],
   "Resource": "*"
  },
  {
   "Sid": "ListBucket",
   "Effect": "Allow",
   "Action": [
    "s3:ListBucket",
    "s3:ListBucketMultipartUploads",
    "s3:GetBucketVersioning"
   ],
   "Resource": "arn:aws:s3:::example-homelab-offsite"
  },
  {
   "Sid": "WriteOwnPrefixes",
   "Effect": "Allow",
   "Action": [
    "s3:PutObject",
    "s3:GetObject",
    "s3:AbortMultipartUpload",
    "s3:ListMultipartUploadParts",
    "s3:GetObjectVersion"
   ],
   "Resource": [
    "arn:aws:s3:::example-homelab-offsite/truenas/*",
    "arn:aws:s3:::example-homelab-offsite/zvol/*"
   ]
  },
  {
   "Sid": "MirrorDeletes",
   "Effect": "Allow",
   "Action": "s3:DeleteObject",
   "Resource": [
    "arn:aws:s3:::example-homelab-offsite/truenas/*"
   ]
  },
  {
   "Sid": "DenyNonDeepArchive",
   "Effect": "Deny",
   "Action": "s3:PutObject",
   "Resource": "arn:aws:s3:::example-homelab-offsite/*",
   "Condition": {
    "StringNotEqualsIfExists": {
     "s3:x-amz-storage-class": "DEEP_ARCHIVE"
    }
   }
  }
 ]
}