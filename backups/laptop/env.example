# /etc/restic/env  (root:root 600). Placeholders only.
NAS_HOST=10.2.1.x
export RESTIC_REPOSITORY=sftp:laptop-backup@10.2.1.x:/mnt/datastore/backups/laptop/restic
export RESTIC_PASSWORD_FILE=/etc/restic/password      # random 32 bytes; ALSO stored in a password manager
export RESTIC_CACHE_DIR=/var/cache/restic
SFTP_CMD="ssh -i /etc/restic/id_ed25519 -o IdentitiesOnly=yes -o BatchMode=yes -o ServerAliveInterval=30 -o UserKnownHostsFile=/etc/restic/known_hosts -o StrictHostKeyChecking=yes laptop-backup@10.2.1.x -s sftp"
