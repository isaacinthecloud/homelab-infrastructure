# Copy to .env next to docker-compose.yaml (chmod 600) and fill in real values.
# .env is git-ignored. Never commit real values.

DOMAIN=example.com
TZ=America/Chicago

# Traefik dashboard basic auth: htpasswd -nB admin  (escape every $ as $$)
TRAEFIK_AUTH=admin:$$2y$$05$$replace-with-bcrypt-hash

# Route53 DNS-01 for Let's Encrypt. Use a dedicated IAM user limited to
# route53:ChangeResourceRecordSets on your hosted zone + read-only listing.
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=replace-me
AWS_REGION=us-east-1
AWS_HOSTED_ZONE_ID=ZXXXXXXXXXXXXXXXXXXXX

# NordVPN service credentials (not the account login) for Gluetun
VPN_USER=replace-me
VPN_PASSWORD=replace-me
