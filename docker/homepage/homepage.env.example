# /root/docker/homepage.env  (chmod 600, never commit)
# Read-only credentials wherever the app supports it.

# Proxmox: token with privilege separation, role PVEAuditor on /
HOMEPAGE_VAR_PROXMOX_TOKEN_ID=root@pam!homepage
HOMEPAGE_VAR_PROXMOX_TOKEN_SECRET=

# TrueNAS: API key of a user with the Read-Only Administrator role
HOMEPAGE_VAR_TRUENAS_KEY=

HOMEPAGE_VAR_PORTAINER_KEY=
# Traefik dashboard basic auth (plain password, not the htpasswd hash)
HOMEPAGE_VAR_TRAEFIK_USER=
HOMEPAGE_VAR_TRAEFIK_PASSWORD=

# UniFi: Network > Settings > Control Plane > Integrations > API key
HOMEPAGE_VAR_UNIFI_URL=https://10.2.0.x
HOMEPAGE_VAR_UNIFI_KEY=

# AdGuard Home has no read-only users; this is the web login
HOMEPAGE_VAR_ADGUARD_USER=
HOMEPAGE_VAR_ADGUARD_PASSWORD=

# Tailscale: machine ID of the subnet router (ends in CNTRL) + API access token
HOMEPAGE_VAR_TAILSCALE_DEVICE_ID=
HOMEPAGE_VAR_TAILSCALE_KEY=

HOMEPAGE_VAR_JELLYFIN_KEY=
HOMEPAGE_VAR_SEERR_KEY=
# Immich: API key with the server.statistics permission
HOMEPAGE_VAR_IMMICH_KEY=

HOMEPAGE_VAR_SONARR_KEY=
HOMEPAGE_VAR_RADARR_KEY=
HOMEPAGE_VAR_LIDARR_KEY=
HOMEPAGE_VAR_PROWLARR_KEY=
HOMEPAGE_VAR_BAZARR_KEY=
HOMEPAGE_VAR_QBITTORRENT_KEY=

# Home Assistant: long-lived token from a dedicated profile, not your own
HOMEPAGE_VAR_HA_TOKEN=
HOMEPAGE_VAR_SYNCTHING_KEY=
